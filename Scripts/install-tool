#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
    printf '%s\n' 'Usage: install-tool <release-binary> <bin-directory>' >&2
    exit 2
fi

agentbuild_source=$1
agentbuild_bin=$2
agentbuild_destination="$agentbuild_bin/agentbuild"

case "$agentbuild_bin" in
    /*) ;;
    *) printf '%s\n' 'Installation paths must be absolute.' >&2; exit 2 ;;
esac

if [ ! -f "$agentbuild_source" ] || [ ! -x "$agentbuild_source" ]; then
    printf '%s\n' 'A built release executable is required.' >&2
    exit 2
fi

if [ -e "$agentbuild_destination" ] || [ -L "$agentbuild_destination" ]; then
    if [ -L "$agentbuild_destination" ] || [ ! -f "$agentbuild_destination" ]; then
        printf '%s\n' 'The install destination must be a regular executable file.' >&2
        exit 2
    fi
fi

/bin/mkdir -p "$agentbuild_bin"
agentbuild_temporary=$(/usr/bin/mktemp "$agentbuild_bin/.agentbuild.XXXXXX")
trap '/bin/rm -f "$agentbuild_temporary"' EXIT HUP INT TERM
/usr/bin/install -m 755 "$agentbuild_source" "$agentbuild_temporary"
/bin/mv -f "$agentbuild_temporary" "$agentbuild_destination"
printf 'Installed %s\n' "$agentbuild_destination"
